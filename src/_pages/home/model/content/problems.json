{
  "texts": {
    "t001": "Знакомая ситуация",
    "t002": "Идея есть.",
    "t003": "А показать нечего.",
    "t004": "Первое конкретное решение помогает двигаться дальше.",
    "t005": "Для инвестора",
    "t006": "Нужен продукт.",
    "t007": "А есть презентация.",
    "t008": "Инвестор просит демо — а у вас только презентация.",
    "t009": "Для команды",
    "t010": "Одна идея.",
    "t011": "Разные представления.",
    "t012": "Команда спорит, каким должен быть продукт.",
    "t013": "Для бизнеса",
    "t014": "Хочется проверить.",
    "t015": "А не сразу потратить.",
    "t016": "Разработка дорогая — проверить гипотезу нечем."
  },
  "images": {},
  "links": {}
}
